+    // Some Motorola optical UDFPS devices need the panel in its FOD high-brightness
+    // mode while the sensor captures, and their HAL leaves that to the system, as
+    // stock does through the panel HAL. Only done while an enroll or authenticate
+    // client is taking the touch, so other touches on the sensor area stay normal.
+    private static final String MOTO_PANEL_DESCRIPTOR =
+            "com.motorola.hardware.display.panel.IDisplayPanel";
+    // IDisplayPanel.setMode(PanelMode mode, out int) is the interface's fifth method.
+    private static final int MOTO_PANEL_SET_MODE = IBinder.FIRST_CALL_TRANSACTION + 4;
+    private static final int MOTO_PANEL_MODE_NORMAL = 0;
+    private static final int MOTO_PANEL_MODE_FOD_HBM = 4;
+    // Never leave the panel in high brightness if the matching pointer up is lost.
+    private static final long MOTO_PANEL_HBM_TIMEOUT_MS = 3000;
+    private final boolean mMotoPanelFodHbm =
+            SystemProperties.getBoolean("persist.sys.ax_fp_moto_panel_hbm", false);
+    private final Runnable mPanelFodHbmTimeout = () -> setPanelFodHbm(false);
+
+    private void setPanelFodHbm(boolean on) {
+        if (!mMotoPanelFodHbm) {
+            return;
+        }
+        mHandler.removeCallbacks(mPanelFodHbmTimeout);
+        if (on) {
+            mHandler.postDelayed(mPanelFodHbmTimeout, MOTO_PANEL_HBM_TIMEOUT_MS);
+        }
+        final IBinder panel = ServiceManager.checkService(MOTO_PANEL_DESCRIPTOR + "/default");
+        if (panel == null) {
+            Slog.w(getTag(), "Motorola panel HAL not available");
+            return;
+        }
+        final Parcel data = Parcel.obtain();
+        final Parcel reply = Parcel.obtain();
+        try {
+            data.writeInterfaceToken(MOTO_PANEL_DESCRIPTOR);
+            data.writeInt(on ? MOTO_PANEL_MODE_FOD_HBM : MOTO_PANEL_MODE_NORMAL);
+            panel.transact(MOTO_PANEL_SET_MODE, data, reply, 0);
+            reply.readException();
+        } catch (RemoteException | RuntimeException e) {
+            Slog.w(getTag(), "Failed to set the panel FOD mode to " + on, e);
+        } finally {
+            reply.recycle();
+            data.recycle();
+        }
+    }
