# Input Devices
genfscon sysfs /devices/virtual/input u:object_r:vendor_sysfs_input:s0

# Memory
genfscon proc /sys/vm/lowmem_reserve_ratio    u:object_r:proc_watermark_boost_factor:s0
genfscon proc /sys/vm/min_free_kbytes         u:object_r:proc_watermark_boost_factor:s0

# Motorola Specific filesystem entries
genfscon proc /bootinfo u:object_r:vendor_proc_hw:s0
genfscon proc /config u:object_r:vendor_proc_hw:s0
genfscon proc /hw u:object_r:vendor_proc_hw:s0
# /cpu_loading/curr_cpu_loading is deliberately not listed here:
# sepolicy_vndr/base/vendor/genfs_contexts already maps it to proc_curr_cpu_loading,
# which is deliberately a distinct type from the other /cpu_loading/* knobs
# (proc_cpu_loading). checkpolicy rejects two genfscon entries for the same
# (fstype, path) outright - see the 'duplicate entry for genfs entry' error - so a
# second entry here is a build failure, not an override.

# Power Supply
# Paths as scout enumerates them (the inherited cybert paths never matched here,
# so the health HAL was denied reading the charge pumps' type).
genfscon sysfs /devices/platform/soc/11e00000.i2c/i2c-3/3-006b/power_supply/cp-master                               u:object_r:sysfs_power_supply:s0
genfscon sysfs /devices/platform/soc/11e00000.i2c/i2c-3/3-006c/power_supply/cp-slave                                u:object_r:sysfs_power_supply:s0
genfscon sysfs /devices/platform/soc/11280000.i2c/i2c-5/5-0034/11280000.i2c:mt6375@34:chg/power_supply/primary_chg  u:object_r:sysfs_power_supply:s0
genfscon sysfs /devices/platform/smart_battery/power_supply/battery                                                 u:object_r:sysfs_power_supply:s0

# Touchpanel
genfscon sysfs /class/touchscreen u:object_r:vendor_sysfs_touchpanel:s0
genfscon sysfs /devices/virtual/touchscreen u:object_r:vendor_sysfs_touchpanel:s0

# Vibrator (aw862xx haptics at i2c-12 0x5a; the HAL writes activate, gain, duration, ...)
genfscon sysfs /devices/platform/soc/11d72000.i2c/i2c-12/12-005a/leds/vibrator                  u:object_r:sysfs_vibrator:s0

# Display panel (read by the Moto display panel HAL)
genfscon sysfs /devices/platform/soc/14000000.dispsys-config/drm/card0/card0-DSI-1/panelName                                u:object_r:vendor_sysfs_graphics:s0
genfscon sysfs /devices/platform/soc/14000000.dispsys-config/drm/card0/card0-DSI-1/panelDC                                  u:object_r:vendor_sysfs_graphics:s0
