<?xml version="1.0" encoding="UTF-8"?>
<!--
  Motorola edge 60 (scout) local manifest for AxionOS (lineage-23.2).
  Copy to .repo/local_manifests/ and run repo sync.
-->
<manifest>
  <remote name="scout" fetch="https://github.com/arthurcelestinoe" />

  <!-- Device and prebuilt stock kernel. Extract the proprietary blobs with
       device/motorola/scout/extract-files.py. -->
  <project path="device/motorola/scout" name="android_device_motorola_scout" remote="scout" revision="main" />
  <project path="device/motorola/scout-kernel" name="android_device_motorola_scout-kernel" remote="scout" revision="main" />

  <!-- Motorola and MediaTek HALs and sepolicy -->
  <project path="hardware/mediatek" name="LineageOS/android_hardware_mediatek" />
  <project path="hardware/motorola" name="LineageOS/android_hardware_motorola" />
  <project path="device/mediatek/sepolicy_vndr" name="LineageOS/android_device_mediatek_sepolicy_vndr" />
  <project path="vendor/mediatek/ims" name="crdroidandroid/android_vendor_mediatek_ims" revision="refs/heads/16.0" />
</manifest>
